source "https://rubygems.org"

# Pins the same Jekyll and plugins GitHub Pages uses, so local preview
# matches the published site. Deploy-from-branch ignores this file and
# builds with GitHub's own environment.
gem "github-pages", group: :jekyll_plugins

# Required to run `jekyll serve` on Ruby 3. Not used by GitHub Pages.
gem "webrick", "~> 1.8"
